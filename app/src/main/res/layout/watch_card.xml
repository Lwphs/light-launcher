<?xml version="1.0" encoding="utf-8"?>
<!-- One "Continue watching" card: picture, title, time left and a progress bar. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="200dp"
    android:layout_height="112dp"
    android:layout_margin="7dp"
    android:background="@drawable/tile_bg"
    android:clickable="true"
    android:clipToOutline="true"
    android:focusable="true"
    android:foreground="@drawable/tile_focus">

    <ImageView
        android:id="@+id/watch_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/where_bg"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="18dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/watch_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/watch_left"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- How much has been watched -->
    <ProgressBar
        android:id="@+id/watch_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="bottom"
        android:max="1000"
        android:progressDrawable="@drawable/watch_progress" />
</FrameLayout>
