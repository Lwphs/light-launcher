<?xml version="1.0" encoding="utf-8"?>
<!-- One service in the filter, full width. Colours per state are in filter_row_bg / filter_text. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:layout_marginBottom="2dp"
    android:background="@drawable/filter_row_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <TextView
        android:id="@+id/filter_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/filter_text"
        android:textSize="16sp" />

    <!-- Shown when the service's app isn't on the TV -->
    <TextView
        android:id="@+id/filter_missing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:text="@string/not_installed"
        android:textColor="@color/hint"
        android:textSize="12sp"
        android:visibility="gone" />

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/filter_check" />
</LinearLayout>
